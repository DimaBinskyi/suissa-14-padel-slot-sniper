{
  "manifest_version": 3,
  "name": "Padel Slot Sniper",
  "version": "0.1.0",
  "description": "Waits for a Google Calendar appointment slot to open (padel court) and books it automatically via the real UI. Notifies you if a captcha appears.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://calendar.google.com/*"],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/calendar/*/appointments/schedules/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://calendar.google.com/calendar/*/appointments/schedules/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
